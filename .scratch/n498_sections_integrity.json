{
 "schemaVersion": 1,
 "documentType": "sections-internal-consistency",
 "ruling": "self-initiated: nothing has ever checked that a section offset indexes the text the section claims. Extraction can read a section either way, and the two disagree silently.",
 "population": "every artifact of every acquired manifest under the private root fulltext/",
 "populationNote": "The private-root population, not the calibration 60 and not the calibration-plus-backfill set.",
 "countingUnit": "sections file (one per artifact)",
 "criterion": "the six invariants read off _with_offsets and the two contentSha256 call sites, listed in the module docstring",
 "separatorChars": 2,
 "controlProbes": [
  {
   "probe": "正向：合成之正確 sections",
   "expectFail": false,
   "failed": false,
   "findings": [],
   "asExpected": true
  },
  {
   "probe": "反向甲：endOffset 少 1",
   "expectFail": true,
   "failed": true,
   "findings": [
    "不變式 1：1 節之 content[start:end] ≠ text",
    "不變式 3：1 處相鄰節之間隔 ≠ 2"
   ],
   "asExpected": true
  },
  {
   "probe": "反向乙：間隔改為 1",
   "expectFail": true,
   "failed": true,
   "findings": [
    "不變式 1：1 節之 content[start:end] ≠ text",
    "不變式 3：2 處相鄰節之間隔 ≠ 2"
   ],
   "asExpected": true
  },
  {
   "probe": "反向丙：contentSha256 改一字元",
   "expectFail": true,
   "failed": true,
   "findings": [
    "不變式 5：contentSha256 與 content 不符"
   ],
   "asExpected": true
  },
  {
   "probe": "反向丁：text 改一字、偏移不動",
   "expectFail": true,
   "failed": true,
   "findings": [
    "不變式 1：1 節之 content[start:end] ≠ text"
   ],
   "asExpected": true
  },
  {
   "probe": "反向戊：sourceSha256 與來源檔不符",
   "expectFail": true,
   "failed": true,
   "findings": [
    "不變式 6：sections 之 sourceSha256 與其來源檔不符"
   ],
   "asExpected": true
  },
  {
   "probe": "反向己：來源檔配錯路徑",
   "expectFail": true,
   "failed": true,
   "findings": [
    "不變式 6：sections 之 sourceSha256 與其來源檔不符"
   ],
   "asExpected": true
  }
 ],
