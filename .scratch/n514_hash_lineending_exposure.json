    "input": "b'abc'",
    "expected": {
     "crlf": false,
     "lf": false,
     "kind": "no-newline"
    }
   }
  ],
  "hashesDifferOnCrlf": true,
  "hashesAgreeOnLf": true,
  "why": "If the comparison is not comparing, zero mismatches and no measurement at all print the same number."
