# AHIG is whitelist-tracked: public code/contracts only.
*
!*/
!*.py
!*.json
!*.ttl
!*.md
# Exact search strategies are public contract artifacts, not private full text.
!calibration/**/queries/*.txt
# 抽樣證據錨定檔：只含雜湊與識別碼，必須進 git（抽樣誠實性護欄）。
!calibration/**/prevalence-audit-anchors.jsonl
!pyproject.toml
!.gitignore

# Private or generated data must never be committed.
corpus/
fulltext/
!tests/fixtures/fulltext/
!tests/fixtures/fulltext/*.xml
data/
indexes/
databases/
jobs/
logs/
secrets/
notebooks/
artifacts/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pyo
**/*.tmp
**/*.log
**/.env
**/.env.*
