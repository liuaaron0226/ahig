{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahig.local/schema/batch-quality-gate/1.0.0",
  "title": "BatchQualityGate",
  "type": "object",
  "required": ["gateId", "fieldType", "sampleUnit", "sampleSize", "batchesIncluded", "goldSetAccuracy", "deterministicResolution", "majorErrorCount", "decision"],
  "additionalProperties": false,
  "properties": {
    "gateId": {"type": "string"},
    "fieldType": {"type": "string"},
    "sampleUnit": {"enum": ["study", "study-result", "field", "conflict"]},
    "sampleSize": {"type": "integer", "minimum": 1},
    "cumulativeSampleSize": {"type": "integer", "minimum": 1},
    "batchesIncluded": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "errorCount": {"type": "integer", "minimum": 0},
    "errorRateUpper95": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "errorRateMethod": {"enum": ["clopper-pearson-one-sided-95", "not-computed"]},
    "agreement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "gwetAC1": {"type": "number", "minimum": -1, "maximum": 1},
        "ciLower95": {"type": "number", "minimum": -1, "maximum": 1},
        "ciUpper95": {"type": "number", "minimum": -1, "maximum": 1},
        "cohenKappa": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "positiveAgreement": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "negativeAgreement": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confusionMatrix": {"type": "array"},
        "modelAssumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "goldSetAccuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "deterministicResolution": {
      "type": "object",
      "required": ["conflictCount", "autoResolvedCount", "coverage", "accuracy"],
      "additionalProperties": false,
      "properties": {
        "conflictCount": {"type": "integer", "minimum": 0},
        "autoResolvedCount": {"type": "integer", "minimum": 0},
        "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "commonWrongAgreementCount": {"type": "integer", "minimum": 0}
      }
    },
    "majorErrorCount": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["pass", "fail", "insufficient-evidence", "manual-only"]},
    "computedAt": {"type": "string", "format": "date-time"}
  }
}
